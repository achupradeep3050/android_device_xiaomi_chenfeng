allow hal_sensors_default audio_socket:sock_file rw_file_perms;
allow hal_sensors_default hal_audio_default:unix_stream_socket connectto;
allow hal_sensors_default sound_device:chr_file rw_file_perms;
allow hal_sensors_default vendor_sysfs_graphics:dir r_dir_perms;
allow hal_sensors_default vendor_sysfs_graphics:file r_file_perms;
allow hal_sensors_default sysfs_tp_virtual_prox:file { open read write };
# The stock prebuilt xiaomi_touch.ko does NOT create the /sys/class/touch/touch_dev/
# gesture_*_enabled nodes, so the DoubleTap/SingleTap/Udfps SysfsPollingOneShotSensor sysfs
# writes are no-ops. The sensors HAL instead arms the panel gesture / FOD-press mode through the
# /dev/xiaomi-touch ioctl (labeled touchfeature_device). This rule lets it open that node.
allow hal_sensors_default touchfeature_device:chr_file rw_file_perms;
# (Harmless: keep read access to the gesture-node labels in case a future kernel creates them.)
allow hal_sensors_default vendor_sysfs_sensors:dir search;
allow hal_sensors_default vendor_sysfs_sensors:file { open read write getattr };
